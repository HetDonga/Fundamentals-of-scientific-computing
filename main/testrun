import numpy as np
import matplotlib.pyplot as plt
import time as time
from matplotlib.animation import FuncAnimation

plt.style.use("ggplot")  # different styles
np.random.seed(0)

N = 45 # number of particles
L = 10.0 # box side length
dt = 0.01 # time step
T = 1000 # number of steps to simulate

pos = np.random.rand(N, 2)
vel = (np.random.rand(N, 2) - 0.5) * 2
mass = np.ones(N) 
m=1           # need a mass varibale of the same value
mass*=m

k = 10
r0 = 0.8
rc = 2.0

def walls_reflect(pos, vel, L):
    # Left wall (x < 0)
    left_hits = pos[:, 0] < 0    #left_hits is a boolean array , (t or f) 
    vel[left_hits, 0] *= -1      # flip x velocity
    pos[left_hits, 0] = 0.0      # push back inside
    # Right wall (x > L)
    right_hits = pos[:, 0] > L 
    vel[right_hits, 0] *= -1
    pos[right_hits, 0] = L
    # Bottom wall (y < 0)
    bottom_hits = pos[:, 1] < 0
    vel[bottom_hits, 1] *= -1
    pos[bottom_hits, 1] = 0.0
    # Top wall (y > L)
    top_hits = pos[:, 1] > L
    vel[top_hits, 1] *= -1
    pos[top_hits, 1] = L


    return pos, vel



def pairwise_distances(pos, rc):
    # Broadcast to get (N, N, 2) displacement vectors without for loops
    d = pos[:, None, :] - pos[None, :, :]
    # Calculate lengths of displacement vectors to get (N, N) distance matrix
    dist = np.linalg.norm(d, axis=-1)
    # Boolean mask: True where 0 < dist <= rc
    neighbors = (dist > 0) & (dist <= rc)

    return d, dist, neighbors



def pair_forces(pos):
    d, dist, neighbors = pairwise_distances(pos, rc)
    u = d / (dist[:, :, None] + 1e-12)
    fmag = -k * (dist - r0) * neighbors
    # Sum across axis 1 to get net force per particle
    F = np.sum(fmag[:, :, None] * u, axis=1)   #shape is n*2

    return F


def kinetic_energy(vel, mass):
    # Axis=1 is column and sums elements of a column
    v_squared = np.sum(vel**2, axis=1)

    return 0.5 * np.sum(mass * v_squared)


def potential_energy(pos):
    d, dist, neighbors = pairwise_distances(pos, rc)

    # Calculate U = 0.5 * k * (r_ij - r0)^2
    # The neighbors mask zeros out interactions beyond rc and self-interactions
    u_matrix = 0.5 * k * (dist - r0)**2 * neighbors
    # Sum the matrix and divide by 2 to correct for double-counting (i->j and j->i)

    return np.sum(u_matrix) / 2.0




# Creates plot with boundaries.
figure ,(axes1,axes2) = plt.subplots(1,2,figsize=(5,5))  #syntax for defining subplots.
axes1.set_xlim(0,L)
axes1.set_ylim(0,L)
axes1.set_aspect("equal")

# Scatter graph plots the points corresponding to the particles.
scatter = axes1.scatter(pos[:,0],pos[:,1])

axes2.set_xlim(0,T)
axes2.set_ylim(0,m*np.sum(vel**2))
axes2.set_title("Kinetic energy")
axes2.set_xlabel("Frame")
axes2.set_ylabel("KE")

(line,)=axes2.plot([],[])# creates empty lists that are ready to be filled/ updates
(line2,)=axes2.plot([],[]) # same thing , but for potential energy.

temp=pos
KE_previous=[]
PE_previous=[]

# Function which updates position of the particles.
def update(frame):

    temp[:]=pos[:]
    pos[:]+=vel*dt
    vel[:]+=(pair_forces(temp)/1)*dt

    walls_reflect(pos,vel,L)
    scatter.set_offsets(pos)  #repositions the molecules.

    KE_previous.append(kinetic_energy(vel,mass))
    line.set_data(range(len(KE_previous)),KE_previous)
    
    PE_previous.append(potential_energy(pos))
    line2.set_data(range(len(PE_previous)),PE_previous)

    axes2.set_ylim(0,max(max(KE_previous)*1.2,max(PE_previous)*1.2))
    
    return scatter , line , line2   # Returns tuple scatter(updated position)



# This is inbuilt animation tool on matplotlib.
animation=FuncAnimation(figure,update,frames=T,interval=dt,blit=True)

plt.tight_layout()  # ensures no text is overwritten.
plt.show()














